{
  "name": "deedwell",
  "private": true,
  "version": "0.1.0",
  "description": "Deedwell — AI workforce and operating workspace for nonprofit organizations",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx packages/database/src/migrate-cli.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "worker": "tsx apps/api/src/worker.ts",
    "poll:ad-grants": "tsx apps/api/src/ad-grants-poller.ts",
    "site-router": "tsx apps/site-router/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fastify/cookie": "^9",
    "@fastify/cors": "^9",
    "@fastify/formbody": "^7",
    "@fastify/static": "^7",
    "@fastify/websocket": "^10",
    "@google-cloud/speech": "^6",
    "@google-cloud/storage": "^7.14.0",
    "@google-cloud/text-to-speech": "^5",
    "docx": "^9.1.1",
    "fastify": "^4.28.1",
    "kokoro-js": "^1",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.1",
    "ws": "^8",
    "zod": "^3.23.8"
  },
  "type": "module"
}
