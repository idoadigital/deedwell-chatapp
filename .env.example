# Admin connection: used ONLY for migrations and the workflow worker's run-claiming.
DATABASE_URL=postgres://deedwell:CHANGE_ME@localhost:5432/deedwell
# App connection: non-superuser role, subject to Row-Level Security.
DATABASE_APP_URL=postgres://deedwell_app:CHANGE_ME@localhost:5432/deedwell
# Password assigned to the deedwell_app role at migration time.
APP_DB_PASSWORD=CHANGE_ME
# Local object-storage root (S3-compatible adapter replaces this in production).
DATA_DIR=./.data
# Model provider: "mock" (deterministic, no network) until a real adapter is configured.
MODEL_PROVIDER=mock
PORT=3000
# Google OAuth (Ad Grants wizard "Connect Google Account" step). Unset =
# the connect step shows an honest "not configured yet" state. Create a
# "Web application" OAuth client in Google Cloud Console → APIs & Services
# → Credentials, with GOOGLE_OAUTH_REDIRECT_URI added as an authorized
# redirect URI (e.g. https://coworkers.deedwell.org/v1/ad-grants/google-oauth/callback).
# Scopes requested are fixed at "openid email profile" — identity only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/v1/ad-grants/google-oauth/callback
